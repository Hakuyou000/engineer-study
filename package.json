{
  "name": "engineer-study",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "gen": "tsx scripts/build-questions.ts",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run gen",
    "test": "vitest run",
    "lint": "eslint .",
    "precoverage": "npm run gen",
    "coverage": "tsx scripts/coverage.ts",
    "premetrics": "npm run gen",
    "metrics": "tsx scripts/metrics.ts",
    "pretriage": "npm run gen",
    "triage": "tsx scripts/triage.ts",
    "check": "npm run lint && npm test && npm run coverage -- --check && npm run build",
    "check-chapter": "tsx scripts/check-chapter.ts"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "^2.3.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
